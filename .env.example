# Örnek ayarlar. Gerçek değerler .env dosyasında tutulur (git dışında).
# .env oluşturmak için: .\scripts\new-env.ps1  (parolayı rastgele üretir, ekrana yazmaz)

# Ana veritabanı (gerçek Olist verisi)
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=change-me

# Test veritabanı (yalnızca sentetik test verisi). Adı _test ile bitmelidir.
POSTGRES_TEST_DB=olist_test

# Dashboard'un bu bilgisayarda açılacağı port (http://127.0.0.1:8501)
DASHBOARD_PORT=8501

# Dashboard'un veritabanı kullanıcısı: yalnızca reporting okuma yetkisi (sql/180_dashboard_reader_role.sql).
# Rol .\scripts\dashboard.ps1 tarafından bu değerlerle oluşturulur/güncellenir.
DASHBOARD_DB_USER=olist_dashboard
DASHBOARD_DB_PASSWORD=change-me

# Yalnızca compose.db-port.yaml kullanılırsa: PostgreSQL'in yerel portu
POSTGRES_HOST_PORT=5432
